{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client",
      "framework": "nextjs"
    },
    "app": {
      "root": "app",
      "framework": "nextjs"
    },
    "backend": {
      "root": "arc/backend",
      "framework": "express",
      "entrypoint": "src/server.ts"
    }
  },
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/dashboard/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "client"
      }
    }
  ]
}
